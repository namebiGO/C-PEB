# C-PEB Express API — Environment Variables
# Copy this file to server/.env and fill in your values

# Server port
PORT=5001

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/cpeb
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/cpeb?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/cpeb

# Comma-separated list of allowed CORS origins (no trailing slashes)
CORS_ORIGIN=http://localhost:5173
