# Frontend environment variables
# The Vite dev server automatically proxies /api/* to localhost:5001 (see vite.config.js)

# Razorpay Payment Page URLs for Startup & Business Advisory Plans
# Paste your generated Razorpay Payment Page links below:
VITE_RAZORPAY_1M_URL="https://pages.razorpay.com/cpeb-advisory-1m"
VITE_RAZORPAY_3M_URL="https://pages.razorpay.com/cpeb-advisory-3m"

# (Optional) Only needed if you still want a Formspree fallback
# VITE_FORMSPREE_ENDPOINT="https://formspree.io/f/YOUR_FORM_ID_HERE"
